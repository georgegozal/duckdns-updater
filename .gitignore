# Real credentials: copy env.example to .env (Compose loads .env automatically).
.env
.env.*

# The state directory the container writes its last-success timestamps into.
# Only appears if someone runs the scripts outside Docker.
/var/
last-success

# test.sh drives real containers and removes them itself, but a killed run can
# leave a log behind.
*.log

# OS and editor droppings. Committing one to a public repo is not a leak, just
# noise that every clone then carries.
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
